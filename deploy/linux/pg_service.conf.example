[pgvn-owner]
host=127.0.0.1
port=5432
dbname=pgvn
user=pgvn_owner
sslmode=verify-full
sslrootcert=/etc/pgvn/postgresql-ca.pem
connect_timeout=3

[pgvn-service]
host=127.0.0.1
port=5432
dbname=pgvn
user=pgvn_service
sslmode=verify-full
sslrootcert=/etc/pgvn/postgresql-ca.pem
connect_timeout=3

[pgvn-monitor]
host=127.0.0.1
port=5432
dbname=pgvn
user=pgvn_monitor
sslmode=verify-full
sslrootcert=/etc/pgvn/postgresql-ca.pem
connect_timeout=3
