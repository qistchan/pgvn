Define PGVN_HOME /opt/pgvn/current
ServerRoot "${PGVN_HOME}/apache"
ServerName localhost
Listen 127.0.0.1:8080
LoadModule unixd_module "${PGVN_HOME}/apache/modules/mod_unixd.so"
# The pinned Apache host embeds the event MPM.
LoadModule authn_core_module "${PGVN_HOME}/apache/modules/mod_authn_core.so"
LoadModule authn_file_module "${PGVN_HOME}/apache/modules/mod_authn_file.so"
LoadModule auth_basic_module "${PGVN_HOME}/apache/modules/mod_auth_basic.so"
LoadModule authz_core_module "${PGVN_HOME}/apache/modules/mod_authz_core.so"
LoadModule authz_user_module "${PGVN_HOME}/apache/modules/mod_authz_user.so"
LoadModule log_config_module "${PGVN_HOME}/apache/modules/mod_log_config.so"
LoadModule headers_module "${PGVN_HOME}/apache/modules/mod_headers.so"
LoadModule dav_module "${PGVN_HOME}/apache/modules/mod_dav.so"
LoadModule dav_pgvn_module "${PGVN_HOME}/apache/modules/mod_dav_pgvn.so"
LoadModule authz_pgvn_module "${PGVN_HOME}/apache/modules/mod_authz_pgvn.so"
User pgvn
Group pgvn
StartServers 1
ServerLimit 1
ThreadsPerChild 32
MaxRequestWorkers 32
MinSpareThreads 1
MaxSpareThreads 32
DefaultRuntimeDir /run/pgvnhttpd
PidFile /run/pgvnhttpd/httpd.pid
ErrorLog /var/log/pgvn/httpd-error.log
LogLevel warn
PgVNConfig /etc/pgvn/pgvn.ini
<Location /svn>
    DAV pgvn
    PgVNPathAuthz short_circuit
    PgVNAdvertiseV2Protocol On
    AuthType Basic
    AuthName "PgVN"
    AuthBasicProvider file
    AuthUserFile /etc/pgvn/http-users
    Require valid-user
</Location>
# Routes retain their mount prefix: use /svn/repository in the PgVN catalog.
# Add the TLS example below before exposing DAV beyond loopback.
