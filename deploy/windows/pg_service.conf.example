[pgvn_admin]
host=@DB_HOST@
port=@DB_PORT@
dbname=@DB_NAME@
user=pgvn_admin
sslmode=@SSL_MODE@
sslrootcert=@PGVN_ROOT@/config.local/postgresql-ca.pem

[pgvn_migrate]
host=@DB_HOST@
port=@DB_PORT@
dbname=@DB_NAME@
user=pgvn_migrate
sslmode=@SSL_MODE@
sslrootcert=@PGVN_ROOT@/config.local/postgresql-ca.pem

[pgvn_backup]
host=@DB_HOST@
port=@DB_PORT@
dbname=@DB_NAME@
user=pgvn_admin
sslmode=@SSL_MODE@
sslrootcert=@PGVN_ROOT@/config.local/postgresql-ca.pem

[pgvn_restore]
host=@DB_HOST@
port=@DB_PORT@
dbname=@DB_NAME@_restore
user=pgvn_restore
sslmode=@SSL_MODE@
sslrootcert=@PGVN_ROOT@/config.local/postgresql-ca.pem
