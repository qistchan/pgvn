ServerRoot "@PGVN_ROOT@/apache"
ServerName localhost
Listen 127.0.0.1:@HTTP_PORT@
ThreadsPerChild 16
LoadModule authn_core_module modules/mod_authn_core.so
LoadModule authn_file_module modules/mod_authn_file.so
LoadModule auth_basic_module modules/mod_auth_basic.so
LoadModule authz_core_module modules/mod_authz_core.so
LoadModule authz_user_module modules/mod_authz_user.so
LoadModule log_config_module modules/mod_log_config.so
LoadModule headers_module modules/mod_headers.so
LoadModule dav_module modules/mod_dav.so
LoadModule dav_pgvn_module modules/mod_dav_pgvn.so
LoadModule authz_pgvn_module modules/mod_authz_pgvn.so
PidFile "@PGVN_ROOT@/state/apache.pid"
ErrorLog "@PGVN_ROOT@/logs/apache-error.log"
LogLevel warn
LogFormat "%t %m %U %>s" pgvn
CustomLog "@PGVN_ROOT@/logs/apache-access.log" pgvn
PgVNConfig "@PGVN_ROOT@/config.local/pgvn-apache.ini"
<Location /svn>
    DAV pgvn
    PgVNPathAuthz short_circuit
    PgVNAdvertiseV2Protocol On
    AuthType Basic
    AuthName "PgVN"
    AuthBasicProvider file
    AuthUserFile "@PGVN_ROOT@/secrets/users.htpasswd"
    Require valid-user
</Location>
